#!/usr/bin/env bash
# Delete leftover build/dest Job objects. Does not delete VMs or vm-catalog disks.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  ./cleanup --namespace <project> [--job <job-name>]
  ./cleanup --namespace <project> --all

Examples:
  ./cleanup --namespace vms --job abc-build-windows-0.1.0-test
  ./cleanup --namespace vms --all

Deletes Job, work PVC, ConfigMap, ServiceAccount, Role, RoleBinding,
and staging pods for that job. Does not delete user VMs or vm-catalog.
EOF
}

NS=""
JOB=""
ALL="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --namespace) NS="${2:-}"; shift 2 ;;
    --job) JOB="${2:-}"; shift 2 ;;
    --all) ALL="true"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: Unknown argument: $1" >&2; usage; exit 1 ;;
  esac
done

[[ -n "${NS}" ]] || { echo "ERROR: --namespace is required" >&2; usage; exit 1; }
oc whoami >/dev/null || { echo "ERROR: oc login first" >&2; exit 1; }

clean_one() {
  local job="$1"
  echo "Cleaning ${NS}/${job}"
  oc delete job "${job}" -n "${NS}" --ignore-not-found
  oc delete pvc "${job}-work" -n "${NS}" --ignore-not-found
  oc delete cm "${job}-scripts" -n "${NS}" --ignore-not-found
  oc delete sa "${job}" -n "${NS}" --ignore-not-found
  oc delete role "${job}" rolebinding "${job}" -n "${NS}" --ignore-not-found
  oc delete pod "${job}-stage" -n "${NS}" --ignore-not-found
  oc delete role "${job}-catalog" rolebinding "${job}-catalog" -n "${NS}" --ignore-not-found 2>/dev/null || true
}

if [[ "${ALL}" == "true" ]]; then
  mapfile -t jobs < <(oc get jobs -n "${NS}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null | grep -E '^abc-(build|dest)-' || true)
  if [[ ${#jobs[@]} -eq 0 ]]; then
    echo "No abc-build / abc-dest Jobs in ${NS}."
    exit 0
  fi
  for j in "${jobs[@]}"; do
    clean_one "${j}"
  done
elif [[ -n "${JOB}" ]]; then
  clean_one "${JOB}"
else
  echo "ERROR: pass --job <name> or --all" >&2
  usage
  exit 1
fi

echo "Done. VMs and vm-catalog were not deleted."
