#!/usr/bin/env bash
# Delete leftover abc-build / abc-dest / abc-xfer Jobs anywhere in the cluster.
# Does not delete VMs or vm-catalog disks.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  ./cleanup
  ./cleanup --namespace <project>
  ./cleanup --namespace <project> --job <job-name>

With no flags: find every abc-build-*, abc-dest-*, abc-xfer-* Job and delete it.
With --namespace: only that project.
With --job: only that Job name (needs --namespace).

Deletes Job, work PVC, ConfigMap, ServiceAccount, Role, RoleBinding,
and staging pods. Does not delete user VMs or vm-catalog.
EOF
}

NS=""
JOB=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --namespace) NS="${2:-}"; shift 2 ;;
    --job) JOB="${2:-}"; shift 2 ;;
    --all) shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: Unknown argument: $1" >&2; usage; exit 1 ;;
  esac
done

oc whoami >/dev/null || { echo "ERROR: oc login first" >&2; exit 1; }

clean_one() {
  local ns="$1" job="$2"
  echo "Cleaning ${ns}/${job}"
  oc delete job "${job}" -n "${ns}" --ignore-not-found
  oc delete pvc "${job}-work" -n "${ns}" --ignore-not-found
  oc delete cm "${job}-scripts" -n "${ns}" --ignore-not-found
  oc delete sa "${job}" -n "${ns}" --ignore-not-found
  oc delete role "${job}" rolebinding "${job}" -n "${ns}" --ignore-not-found
  oc delete pod "${job}-stage" -n "${ns}" --ignore-not-found
  oc delete role "${job}-catalog" rolebinding "${job}-catalog" -n "${ns}" --ignore-not-found 2>/dev/null || true
}

if [[ -n "${JOB}" ]]; then
  [[ -n "${NS}" ]] || { echo "ERROR: --job needs --namespace" >&2; exit 1; }
  clean_one "${NS}" "${JOB}"
  echo "Done. VMs and vm-catalog were not deleted."
  exit 0
fi

if [[ -n "${NS}" ]]; then
  mapfile -t jobs < <(oc get jobs -n "${NS}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null | grep -E '^abc-(build|dest|xfer)-' || true)
  if [[ ${#jobs[@]} -eq 0 ]]; then
    echo "No abc-build / abc-dest / abc-xfer Jobs in ${NS}."
    exit 0
  fi
  for j in "${jobs[@]}"; do
    clean_one "${NS}" "${j}"
  done
  echo "Done. VMs and vm-catalog were not deleted."
  exit 0
fi

echo "Looking for abc-build / abc-dest / abc-xfer Jobs in the whole cluster..."
mapfile -t rows < <(oc get jobs -A -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null | grep -E $'\tabc-(build|dest|xfer)-' || true)

if [[ ${#rows[@]} -eq 0 ]]; then
  echo "No leftover build/dest/xfer Jobs found."
  exit 0
fi

for row in "${rows[@]}"; do
  ns="${row%%$'\t'*}"
  job="${row#*$'\t'}"
  clean_one "${ns}" "${job}"
done

echo "Done. VMs and vm-catalog were not deleted."
