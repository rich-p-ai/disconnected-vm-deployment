# Placeholder ImageSetConfiguration for oc-mirror plugin v2.
# Fact: apiVersion mirror.openshift.io/v2alpha1
# https://docs.redhat.com/en/documentation/openshift_container_platform/4.18/html/disconnected_environments/about-installing-oc-mirror-v2
# Pin minVersion/maxVersion to one tested z-stream. Do not leave versions open-ended in air-gap.
---
kind: ImageSetConfiguration
apiVersion: mirror.openshift.io/v2alpha1
mirror:
  platform:
    architectures:
      - amd64
    channels:
      - name: stable-4.18
        minVersion: 4.18.REPLACE
        maxVersion: 4.18.REPLACE
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.18
      packages:
        - name: kubevirt-hyperconverged
        # Optional MTV disconnected landing path (MTV 2.9.2+):
        # - name: mtv-operator
