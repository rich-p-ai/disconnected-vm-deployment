---
# Placeholder inventory. No real hosts. Copy to a gitignored inventory for use.
all:
  vars:
    ansible_connection: local
    ansible_python_interpreter: "{{ ansible_playbook_python }}"
    mirror_registry: registry.example.internal:8443
    oc_mirror_config: "{{ playbook_dir }}/../../scripts/imageset-config.yaml.example"
    oc_mirror_workspace: "{{ playbook_dir }}/../../oc-mirror-workspace"
  children:
    bastion:
      hosts:
        bastion.example.internal:
    registry:
      hosts:
        registry.example.internal:
    cluster:
      hosts:
        api.example.internal:
